# =============================================================================
# Backend Environment Configuration Template
# Copy this file to .env or set variables in your execution environment.
# NEVER commit real credentials to version control.
# =============================================================================

# Server Port (default: 8080)
SERVER_PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/resume_builder
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Secret Key (HMAC-SHA256, minimum 32 characters / 256 bits)
JWT_SECRET=your_secure_256_bit_jwt_secret_key_at_least_32_chars_long

# JWT Token Expiration in Milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# AI Provider Configuration
# Supported providers: openai, gemini, custom
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
