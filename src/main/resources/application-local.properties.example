# =============================================================================
# Local Development Configuration Example
# Copy this file to application-local.properties (same directory) and fill in
# your actual values. That file is gitignored and will never be committed.
#
# When present, this file is loaded by Spring Boot via:
#   spring.config.import=optional:application-local.properties
# It overrides any property from application.properties, so you only need to
# set the values you want to change.
# =============================================================================

# ---- MySQL ---------------------------------------------------------------
# Replace with your actual MySQL password.
spring.datasource.url=jdbc:mysql://localhost:3306/resume_builder
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD_HERE

# ---- JWT -----------------------------------------------------------------
# Must be at least 32 characters (256 bits) for HMAC-SHA256.
# Generate with: openssl rand -hex 32
jwt.secret=REPLACE_ME_WITH_AT_LEAST_32_CHARACTER_SECRET_KEY_12345678

# ---- AI (optional for local testing) ------------------------------------
# Leave blank to disable AI features locally, or add your key to test them.
ai.api-key=YOUR_OPENAI_OR_GEMINI_API_KEY_HERE
# ai.provider=openai
# ai.base-url=https://api.openai.com/v1
# ai.model=gpt-4o-mini

# ---- CORS ---------------------------------------------------------------
# Defaults allow the Vite dev server; no change usually needed locally.
# cors.allowed-origins=http://localhost:5173,http://localhost:5174

# ---- DDL -----------------------------------------------------------------
# Use 'create-drop' to reset schema on every restart, or 'validate' to be strict.
# spring.jpa.hibernate.ddl-auto=update

